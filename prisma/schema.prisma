generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String        @id
  name             String
  email            String        @unique
  emailVerified    Boolean
  image            String?
  createdAt        DateTime
  updatedAt        DateTime
  twoFactorEnabled Boolean?
  sessions         Session[]
  accounts         Account[]
  twoFactors       TwoFactor[]
  bankAccounts     BankAccount[]
  payslips         Payslip[]
  tags             Tag[]
  debts            Debt[]
  passkeys         Passkey[]

  @@map("user")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model BankAccount {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankName     String
  number       String
  type         String
  balance      Decimal?      @db.Decimal(14, 2)
  balanceDate  DateTime?
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([userId, bankName, number])
  @@map("bank_account")
}

model Transaction {
  id          String           @id @default(cuid())
  accountId   String
  account     BankAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  externalId  String
  date        DateTime
  amount      Decimal          @db.Decimal(14, 2)
  description String
  createdAt   DateTime         @default(now())
  tags        TransactionTag[]

  @@unique([accountId, externalId])
  @@index([accountId, date])
  @@map("transaction")
}

// Tag para agrupar transações; uma transação pode ter várias
model Tag {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  /// Chave da paleta (blue, orange, aqua, yellow, magenta, violet)
  color             String
  /// Transferência entre contas próprias, crédito do Pix no cartão etc.:
  /// a transação aparece na lista, mas não conta em entradas, saídas e gastos
  excludeFromTotals Boolean          @default(false)
  transactions      TransactionTag[]
  rules             TagRule[]
  createdAt         DateTime         @default(now())

  @@unique([userId, name])
  @@map("tag")
}

model TransactionTag {
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tagId         String
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@index([tagId])
  @@map("transaction_tag")
}

// "Descrição contém <pattern>" → aplica a tag (sem diferenciar maiúsculas e acentos)
model TagRule {
  id        String   @id @default(cuid())
  tagId     String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  pattern   String
  createdAt DateTime @default(now())

  @@unique([tagId, pattern])
  @@map("tag_rule")
}

// Holerite (recibo de pagamento de salário) importado de PDF
model Payslip {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  employerName     String
  employerCnpj     String
  /// Primeiro dia do mês de competência (UTC)
  competence       DateTime
  grossAmount      Decimal       @db.Decimal(14, 2)
  deductionsAmount Decimal       @db.Decimal(14, 2)
  netAmount        Decimal       @db.Decimal(14, 2)
  fgtsAmount       Decimal?      @db.Decimal(14, 2)
  items            PayslipItem[]
  createdAt        DateTime      @default(now())

  @@unique([userId, employerCnpj, competence])
  @@map("payslip")
}

enum PayslipItemKind {
  EARNING
  DEDUCTION
}

model PayslipItem {
  id          String          @id @default(cuid())
  payslipId   String
  payslip     Payslip         @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  code        String
  description String
  reference   String?
  kind        PayslipItemKind
  amount      Decimal         @db.Decimal(14, 2)

  @@index([payslipId])
  @@map("payslip_item")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("twoFactor")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

enum DebtKind {
  /// Mesmo valor todo mês (aluguel, internet, assinatura)
  FIXED
  /// Todo mês, mas o valor muda (luz, fatura do cartão)
  RECURRING
  /// Número fechado de parcelas (empréstimo, compra parcelada)
  INSTALLMENT
}

model Debt {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  kind         DebtKind
  /// Valor por mês; na parcelada, o valor de cada parcela
  amount       Decimal  @db.Decimal(14, 2)
  /// Dia do vencimento (1 a 31)
  dueDay       Int?
  /// Total de parcelas (só na parcelada)
  installments Int?
  /// Primeiro dia do mês do primeiro vencimento (UTC)
  startMonth   DateTime
  /// Trecho da descrição (sem acento, minúsculo) que identifica os pagamentos nas transações
  pattern      String
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("debt")
}
