# Banco (PostgreSQL). O app usa DATABASE_URL; as migrações usam DIRECT_URL (sem pooler)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/ohara"
DIRECT_URL="postgresql://usuario:senha@localhost:5432/ohara"

# Autenticação (obrigatórias)
# BETTER_AUTH_SECRET: criptografa o segredo do TOTP e assina sessões. Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET="gere com: openssl rand -base64 32"
# BETTER_AUTH_URL: endereço público do app; define o domínio da passkey e os links dos e-mails
BETTER_AUTH_URL="http://localhost:3000"
# ADMIN_EMAIL: único usuário do app; o login por código só vale para ele
ADMIN_EMAIL="voce@exemplo.com"
# ADMIN_NAME: nome exibido (opcional, padrão "Admin")
ADMIN_NAME="Seu nome"

# E-mails (opcionais: sem elas os e-mails ficam desligados)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="voce@exemplo.com"
SMTP_PASS="senha de app do Gmail"
